    "main": "index.ts",
    "scripts": {
        "start": "dotenv -- node index.ts",
        "build": "tsc"
    },
    "keywords": [
        "bip39",
        "bip32",
        "wallet",
        "bitcoin",
        "ethereum",
        "typescript"
    ],
    "author": "Federico Giovannacci - CoBuilders Challenge",
    "license": "MIT",
    "dependencies": {
        "bip32": "^1.0.0",
        "bip39": "3.0.4",
        "bitcoinjs-lib": "^6.1.0",
        "ethers": "^6.0.0"
    },
    "devDependencies": {
        "@types/bip32": "^1.0.2",
        "@types/bip39": "^2.4.2",
        "dotenv-cli": "^8.0.0",
        "ts-node": "^10.9.1",
        "typescript": "^5.4.0"
    }
